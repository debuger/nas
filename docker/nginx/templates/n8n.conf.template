server {
    listen ${NGINX_SSL_PORT} ssl;
    listen [::]:${NGINX_SSL_PORT} ssl;
    http2 on;
    include "conf.d/include/gzip.conf";
    include "conf.d/include/site-block.conf";
    error_log  /log/nginx/n8n.log error;
    access_log /log/nginx/n8n.log main;
    server_name n8n.${NGINX_HOST};
    client_max_body_size 512M;
    large_client_header_buffers 4 32k;

    include "conf.d/include/ssl.conf";
    ssl_certificate /var/www/certbot/config/live/n8n.${NGINX_HOST}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /var/www/certbot/config/live/n8n.${NGINX_HOST}/privkey.pem; # managed by Certbot
    ssl_trusted_certificate /var/www/certbot/config/live/n8n.${NGINX_HOST}/chain.pem;
    location / {
        include "conf.d/include/proxy.headers.conf";
        proxy_http_version  1.1;
        proxy_redirect      off;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "Upgrade";
        proxy_pass          http://n8n-main:5678;
        ##
        # Disable buffering for the streaming responses (SSE)
    	chunked_transfer_encoding off;
    	proxy_cache off;
    	proxy_buffering on;
    	proxy_buffers 10 16k;
    	proxy_buffer_size 32k;
        ##
        # Conections Timeouts (1hr)
        keepalive_timeout 3600s;
    	proxy_connect_timeout 3600s;
    	proxy_read_timeout 3600s;
    	proxy_send_timeout 3600s;
        ##
    }
}